# Docker Compose
IMAGE_TAG=latest
NGINX_PORT=80
FRONTEND_PORT=3000
BACKEND_PORT=8080

# Frontend: nilai ini masuk ke browser, jangan isi secret.
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Frontend server-side di dalam jaringan Compose.
BACKEND_INTERNAL_URL=http://backend:8080/api/v1

# Backend: server-only, jangan pernah memberi prefix NEXT_PUBLIC_.
# DATABASE_URL gunakan connection string Supabase/pooler, misalnya:
# postgresql://<user>:<password>@<host>:<port>/<database>?sslmode=require
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SHUTDOWN_TIMEOUT=10s
