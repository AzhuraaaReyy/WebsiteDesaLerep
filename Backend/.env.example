# Backend lokal
PORT=8080
SHUTDOWN_TIMEOUT=10s

# Kredensial database dipisah (SCHEMA.md 9.3, ARCHITECTURE.md 11.7 / AR-12).
# Gunakan Supabase Session pooler, misalnya:
# postgresql://<user>.<project-ref>:<password>@<host>:5432/postgres?sslmode=require

# Runtime Go API: role `app_runtime` (bukan postgres/owner).
# User pooler: app_runtime.<project-ref>. Opsional: kosongkan untuk jalan tanpa database.
DATABASE_URL=

# Hanya untuk `go run ./cmd/migrate` dan `go run ./cmd/seed`: role owner `postgres`.
# User pooler: postgres.<project-ref>. Jangan dipakai runtime.
MIGRATION_DATABASE_URL=

# Origin browser yang boleh memanggil API langsung (pisahkan dengan koma).
# Untuk frontend `npm run dev` native. Kosongkan jika akses lewat nginx (same-origin).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Disiapkan untuk modul Supabase berikutnya.
# Service role key hanya boleh berada di backend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
