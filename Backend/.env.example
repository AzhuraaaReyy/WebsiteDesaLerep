# Backend lokal
PORT=8080
SHUTDOWN_TIMEOUT=10s

# Opsional. Kosongkan untuk menjalankan tanpa database.
# Gunakan connection string Supabase/pooler, misalnya:
# postgresql://<user>:<password>@<host>:<port>/<database>?sslmode=require
DATABASE_URL=

# Disiapkan untuk modul Supabase berikutnya.
# Service role key hanya boleh berada di backend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
