{
    "swagger": "2.0",
    "info": {
        "description": "API Website Desa Lerep. Semua respons memakai envelope {success, message, data} atau {success, message, errors}. Timestamp dalam UTC (tampilkan Asia/Jakarta); tanggal tanpa waktu berformat YYYY-MM-DD. Field *_path adalah path Supabase Storage, bukan URL siap pakai.",
        "title": "Website Desa Lerep API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/api/v1",
    "paths": {
        "/hamlets": {
            "get": {
                "description": "Dusun aktif, urut nama. `latitude`/`longitude` selalu sama-sama null atau sama-sama terisi. `head_of_hamlet` bisa null.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Profil Desa"
                ],
                "summary": "Daftar dusun",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/village.hamletsResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/response.ErrorEnvelope"
                        }
                    },
                    "503": {
                        "description": "Database belum dikonfigurasi",
                        "schema": {
                            "$ref": "#/definitions/response.ErrorEnvelope"
                        }
                    }
                }
            }
        },
        "/village-officials": {
            "get": {
                "description": "Perangkat desa aktif, urut `sort_order`. Bagan struktur organisasi disusun dari `parent_official_id` (null = paling atas). `hamlet` hanya terisi untuk perangkat tingkat dusun. Tanggal berformat YYYY-MM-DD.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Profil Desa"
                ],
                "summary": "Daftar perangkat desa",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/village.officialsResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/response.ErrorEnvelope"
                        }
                    },
                    "503": {
                        "description": "Database belum dikonfigurasi",
                        "schema": {
                            "$ref": "#/definitions/response.ErrorEnvelope"
                        }
                    }
                }
            }
        },
        "/village-profile": {
            "get": {
                "description": "Profil desa (singleton). Field kosong bernilai null. `office_hours`: key nama hari huruf kecil (senin..minggu), null berarti tutup; urutan key tidak dijamin. `updated_at` dalam UTC.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Profil Desa"
                ],
                "summary": "Profil desa",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/village.profileResponse"
                        }
                    },
                    "404": {
                        "description": "Profil desa belum tersedia",
                        "schema": {
                            "$ref": "#/definitions/response.ErrorEnvelope"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/response.ErrorEnvelope"
                        }
                    },
                    "503": {
                        "description": "Database belum dikonfigurasi",
                        "schema": {
                            "$ref": "#/definitions/response.ErrorEnvelope"
                        }
                    }
                }
            }
        }
    },
